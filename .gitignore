# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
dist-app/

# chart pipeline scratch: ~100 MB of NOAA DEM tiles and Overpass responses,
# plus the PNG previews verify.py renders. All of it is re-fetchable with
# scripts/charts/fetch_dem.py and fetch_osm.py, and none of it belongs in git —
# the committed artifact is src/lib/charts/generated/.
scripts/charts/cache/
scripts/charts/preview/
__pycache__/

# d3k writes this while it has a browser attached
.d3k-browser.pid
